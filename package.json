{
	"name": "@acdh-oeaw/calendar-component",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/acdh-oeaw/calendar-component.git"
	},
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "~12.23.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.23.0",
	"main": "./dist/calendar.umd.cjs",
	"module": "./dist/calendar.js",
	"types": "./dist/calendar.d.ts",
	"exports": {
		".": {
			"types": "./dist/calendar.d.ts",
			"import": "./dist/calendar.js",
			"require": "./dist/calendar.umd.cjs"
		},
		"./i18n/de": "./dist/i18n/de.js",
		"./i18n/en": "./dist/i18n/en.js",
		"./calendar.css": "./dist/calendar.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc --project tsconfig.build.json",
		"changeset:add": "changeset add",
		"changeset:status": "changeset status --verbose",
		"ci:release": "changeset publish",
		"ci:version": "changeset version",
		"dev": "vite dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint:check": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "run-s setup",
		"prepublishOnly": "run-s validate build",
		"setup": "is-in-ci || lefthook install",
		"start": "vite preview",
		"test": "node --test ./src/*.test.ts",
		"types:check": "tsc --noEmit",
		"validate": "run-p format:check lint:check types:check test"
	},
	"devDependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/tsconfig-lib": "^1.3.0",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"is-in-ci": "^2.0.0",
		"jsdom": "^31.0.1",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^9.1.0",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2008",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-static-copy": "^4.1.1"
	}
}
